# Usar a imagem oficial do GCC
FROM gcc:latest

# Definir o diretório de trabalho
WORKDIR /app

# Copiar todos os arquivos do diretório atual para o container
COPY . .

# Compilar o cliente com a biblioteca cJSON
RUN gcc  cliente.c cJSON.c -o cliente_bin

# Comando para iniciar o cliente
CMD ["./cliente_bin"]