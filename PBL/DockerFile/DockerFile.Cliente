# Usar a imagem oficial do GCC
FROM gcc:latest

# Definir o diretório de trabalho
WORKDIR /app

# Copiar apenas as pastas necessárias (contexto de build = raiz do projeto)
COPY src/ ./src/
COPY cJSON/ ./cJSON/

# Compilar o cliente com a biblioteca cJSON
# -I indica onde estão os cabeçalhos (cJSON.h e formatos.h), sem precisar alterar os #include
RUN gcc -I cJSON -I src src/cliente.c cJSON/cJSON.c -o cliente_bin -lm

# Executar a partir da RAIZ do projeto:
# docker build -t app-cliente -f DockerFile/DockerFile.Cliente .
# docker run -it app-cliente

# Comando para iniciar o cliente
CMD ["./cliente_bin"]